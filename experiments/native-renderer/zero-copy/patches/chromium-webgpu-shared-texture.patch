From ae61d9f9b7dbf318d7cdebbf0256f50b2298572f Mon Sep 17 00:00:00 2001
From: Ben Jude <19900120+fractaal@users.noreply.github.com>
Date: Sat, 7 Nov 2026 09:51:10 +0800
Subject: [PATCH] A page can write a frame into a DMA-BUF another process
 shares, with WebGPU

GPUDevice.importSharedTexture(videoFrame, usage) gives the GPU texture behind a VideoFrame (one made by Electron's
sharedTexture from a DMA-BUF) with the usages asked for, so a render worker draws its frame straight into a buffer the
editor shows; destroy() ends the access. WebGPUMailboxTexture::FromVideoFrame honours the usage it is given (its one
caller passes TextureBinding).

Desktop Linux keeps WebGPU off Ozone images for want of sync fences between WebGPU and GL on one image; the feature
EphemerisWebGPUNativePixmap (off by default) allows it, for a process whose imports WebGPU alone uses, and asks Dawn for
SharedTextureMemoryDmaBuf and SharedFenceSyncFD on its WebGPU devices.
---
 .../ozone_image_backing_factory.cc            |  3 +-
 .../service/webgpu_decoder_impl.cc            | 13 ++++++++
 gpu/config/gpu_finch_features.cc              |  6 ++++
 gpu/config/gpu_finch_features.h               |  2 ++
 .../renderer/modules/webgpu/gpu_device.cc     | 33 +++++++++++++++++++
 .../renderer/modules/webgpu/gpu_device.h      |  4 +++
 .../renderer/modules/webgpu/gpu_device.idl    |  2 ++
 .../graphics/gpu/webgpu_mailbox_texture.cc    |  2 +-
 8 files changed, 63 insertions(+), 2 deletions(-)

diff --git a/gpu/command_buffer/service/shared_image/ozone_image_backing_factory.cc b/gpu/command_buffer/service/shared_image/ozone_image_backing_factory.cc
index dfa3858f21..899d69337f 100644
--- a/gpu/command_buffer/service/shared_image/ozone_image_backing_factory.cc
+++ b/gpu/command_buffer/service/shared_image/ozone_image_backing_factory.cc
@@ -385,7 +385,8 @@ bool OzoneImageBackingFactory::CanImportNativePixmapToWebGPU() {
   // This testing in runtime can be done where graphite is enabled by checking
   // against features in the 'dawn_context_provider' in the
   // 'shared_context_state_'.
-  return false;
+  // (Ephemeris: unless asked, for images WebGPU alone uses)
+  return base::FeatureList::IsEnabled(features::kEphemerisWebGPUNativePixmap);
 #endif
 }
 
diff --git a/gpu/command_buffer/service/webgpu_decoder_impl.cc b/gpu/command_buffer/service/webgpu_decoder_impl.cc
index 1d01a9b544..8a78e5883d 100644
--- a/gpu/command_buffer/service/webgpu_decoder_impl.cc
+++ b/gpu/command_buffer/service/webgpu_decoder_impl.cc
@@ -1520,6 +1520,19 @@ WGPUFuture WebGPUDecoderImpl::RequestDeviceImpl(
       required_features.push_back(feature);
     }
   }
+#if BUILDFLAG(IS_LINUX)
+  // (Ephemeris) DMA-BUF images for WebGPU on desktop Linux too, where asked: the
+  // Ozone backing gives them to Dawn as shared texture memory
+  if (base::FeatureList::IsEnabled(features::kEphemerisWebGPUNativePixmap)) {
+    for (wgpu::FeatureName feature :
+         {wgpu::FeatureName::SharedTextureMemoryDmaBuf,
+          wgpu::FeatureName::SharedFenceSyncFD}) {
+      if (adapter_obj.HasFeature(feature)) {
+        required_features.push_back(feature);
+      }
+    }
+  }
+#endif
 
 #if BUILDFLAG(USE_DAWN) && BUILDFLAG(DAWN_ENABLE_BACKEND_OPENGLES)
   // If adapter_options.forceFallbackAdapter is set to true,
diff --git a/gpu/config/gpu_finch_features.cc b/gpu/config/gpu_finch_features.cc
index 350c6d12ed..eff720c148 100644
--- a/gpu/config/gpu_finch_features.cc
+++ b/gpu/config/gpu_finch_features.cc
@@ -132,6 +132,12 @@ bool IsDeviceBlocked(std::string_view field, std::string_view block_list) {
 // purge as much in case of memory pressure.
 BASE_FEATURE(kAggressiveShaderCacheLimits, base::FEATURE_DISABLED_BY_DEFAULT);
 
+// (Ephemeris) Off by default: Chromium keeps WebGPU off Ozone images on desktop
+// Linux for want of sync fences between WebGPU and GL on one image. A process
+// whose imports WebGPU alone uses (a render worker writing frames it shares)
+// needs none.
+BASE_FEATURE(kEphemerisWebGPUNativePixmap, base::FEATURE_DISABLED_BY_DEFAULT);
+
 #if BUILDFLAG(IS_ANDROID)
 // Use android SurfaceControl API for managing display compositor's buffer queue
 // and using overlays on Android. Also used by webview to disable surface
diff --git a/gpu/config/gpu_finch_features.h b/gpu/config/gpu_finch_features.h
index 61c6b96223..13dd037a6e 100644
--- a/gpu/config/gpu_finch_features.h
+++ b/gpu/config/gpu_finch_features.h
@@ -28,6 +28,8 @@ namespace features {
 // All features in alphabetical order. The features should be documented
 // alongside the definition of their values in the .cc file.
 GPU_CONFIG_EXPORT BASE_DECLARE_FEATURE(kAggressiveShaderCacheLimits);
+// (Ephemeris) WebGPU may use an imported native pixmap (a DMA-BUF) on desktop Linux
+GPU_CONFIG_EXPORT BASE_DECLARE_FEATURE(kEphemerisWebGPUNativePixmap);
 
 #if BUILDFLAG(IS_ANDROID)
 GPU_CONFIG_EXPORT BASE_DECLARE_FEATURE(kAndroidSurfaceControl);
diff --git a/third_party/blink/renderer/modules/webgpu/gpu_device.cc b/third_party/blink/renderer/modules/webgpu/gpu_device.cc
