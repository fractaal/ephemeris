@@ -59,6 +59,8 @@ GPU_CONFIG_EXPORT extern const char kDisableSkiaGraphitePrecompilation[];
 GPU_CONFIG_EXPORT extern const char kEnableSkiaGraphitePrecompilation[];
 GPU_CONFIG_EXPORT extern const char kEnableGpuMainTimeKeeperMetrics[];
 GPU_CONFIG_EXPORT extern const char kSuppressPerformanceLogs[];
+GPU_CONFIG_EXPORT extern const char kGpuLowPrioritySite[];
+GPU_CONFIG_EXPORT extern const char kGpuStreamPriorityLow[];
 
 }  // namespace switches
 
diff --git a/gpu/ipc/client/command_buffer_proxy_impl.cc b/gpu/ipc/client/command_buffer_proxy_impl.cc
index 24242e16b7..cfee5ba2fc 100644
--- a/gpu/ipc/client/command_buffer_proxy_impl.cc
+++ b/gpu/ipc/client/command_buffer_proxy_impl.cc
@@ -30,6 +30,7 @@
 #include "gpu/ipc/client/gpu_channel_host.h"
 #include "gpu/ipc/common/command_buffer_id.h"
 #include "gpu/ipc/common/gpu_channel.mojom.h"
