From: Ben Jude <19900120+fractaal@users.noreply.github.com>
Date: Sat, 7 Nov 2026 03:19:05 +0800
Subject: [PATCH 4/5] Renderers of sites given with --gpu-low-priority-site run
 their GPU work at low priority

A renderer process locked to one of them is launched with --gpu-stream-priority-low, and every GPU context it makes
(WebGPU, WebGL, canvases, its compositor) asks for SchedulingPriority::kLow, which now reaches the GPU process as itself
(it was sent as kNormal); renderers' raster workers, which asked for kLow and so got kNormal, ask for kNormal. The
editor's window then gets its turn on the GPU process's main thread between the tasks of a film page drawing heavy frames
in it.
---
 .../renderer_host/render_process_host_impl.cc | 20 +++++++++++++++++++
 content/public/common/gpu_stream_constants.h  |  5 +++--
 gpu/config/gpu_switches.cc                    | 10 ++++++++++
 gpu/config/gpu_switches.h                     |  2 ++
 gpu/ipc/client/command_buffer_proxy_impl.cc   |  8 ++++++++
 .../common/scheduling_priority_mojom_traits.h |  2 +-
 6 files changed, 44 insertions(+), 3 deletions(-)

diff --git a/content/browser/renderer_host/render_process_host_impl.cc b/content/browser/renderer_host/render_process_host_impl.cc
index d4f0389839..c2b6668479 100644
--- a/content/browser/renderer_host/render_process_host_impl.cc
+++ b/content/browser/renderer_host/render_process_host_impl.cc
@@ -56,6 +56,7 @@
 #include "base/rand_util.h"
 #include "base/strings/strcat.h"
 #include "base/strings/string_number_conversions.h"
+#include "base/strings/string_split.h"
 #include "base/strings/string_util.h"
 #include "base/strings/stringprintf.h"
 #include "base/supports_user_data.h"
@@ -3745,6 +3746,25 @@ void RenderProcessHostImpl::AppendRendererCommandLine(
     command_line->AppendSwitch(switches::kTopChromeWebUI);
   }
 
+  // A renderer locked to a site the browser was told to put behind the rest
+  // (--gpu-low-priority-site): its GPU work at low priority.
+  if (const base::CommandLine& own = *base::CommandLine::ForCurrentProcess();
+      own.HasSwitch(::switches::kGpuLowPrioritySite)) {
+    const GURL lock = GetProcessLock().GetProcessLockURL();
+    const std::string sites =
+        own.GetSwitchValueASCII(::switches::kGpuLowPrioritySite);
+    for (std::string_view site :
+         base::SplitStringPiece(sites, ",", base::TRIM_WHITESPACE,
+                                base::SPLIT_WANT_NONEMPTY)) {
+      const GURL url(site);
+      if (lock.is_valid() && url.is_valid() && lock.scheme() == url.scheme() &&
+          lock.host() == url.host()) {
+        command_line->AppendSwitch(::switches::kGpuStreamPriorityLow);
+        break;
+      }
+    }
+  }
+
   if (ShouldSendGpuChannelEarly()) {
     command_line->AppendSwitchASCII(
         switches::kGpuClientId, base::NumberToString(gpu_client_->client_id()));
diff --git a/content/public/common/gpu_stream_constants.h b/content/public/common/gpu_stream_constants.h
index b23c5e0aa4..21041c0105 100644
