+void GPUCommandEncoder::buildAccelerationStructure(
+    DawnObject<wgpu::AccelerationStructure>* destination,
+    const GPUAccelerationStructureBuildDescriptor* webgpu_desc) {
+  wgpu::AccelerationStructureBuildDescriptor dawn_desc = {};
+  if (webgpu_desc->hasVertexBuffer()) {
+    dawn_desc.vertexBuffer = AsDawnType(webgpu_desc->vertexBuffer());
+  }
+  dawn_desc.vertexOffset = webgpu_desc->vertexOffset();
+  dawn_desc.vertexStride = webgpu_desc->vertexStride();
+  dawn_desc.vertexCount = webgpu_desc->vertexCount();
+  if (webgpu_desc->hasIndexBuffer()) {
+    dawn_desc.indexBuffer = AsDawnType(webgpu_desc->indexBuffer());
+  }
+  dawn_desc.indexOffset = webgpu_desc->indexOffset();
+  dawn_desc.indexCount = webgpu_desc->indexCount();
+  if (webgpu_desc->hasAabbBuffer()) {
+    dawn_desc.aabbBuffer = AsDawnType(webgpu_desc->aabbBuffer());
+  }
+  dawn_desc.aabbOffset = webgpu_desc->aabbOffset();
+  dawn_desc.aabbStride = webgpu_desc->aabbStride();
+  dawn_desc.aabbCount = webgpu_desc->aabbCount();
+  dawn_desc.opaque = webgpu_desc->opaque();
+
+  std::unique_ptr<wgpu::AccelerationStructure[]> sources =
+      AsDawnType(webgpu_desc->sources());
+  dawn_desc.sourceCount = webgpu_desc->sources().size();
+  dawn_desc.sources = sources.get();
+
+  if (webgpu_desc->hasInstanceData()) {
+    base::span<const uint8_t> data = webgpu_desc->instanceData()->ByteSpan();
+    dawn_desc.instanceDataCount = data.size() / sizeof(uint32_t);
+    dawn_desc.instanceData = reinterpret_cast<const uint32_t*>(data.data());
+  }
+
+  GetHandle().BuildAccelerationStructure(destination->GetHandle(), &dawn_desc);
+}
