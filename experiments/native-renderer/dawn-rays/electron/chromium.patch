@@ -24,7 +24,7 @@ struct GPU_IPC_COMMON_EXPORT EnumTraits<gpu::mojom::SchedulingPriority,
       case gpu::SchedulingPriority::kNormal:
         return gpu::mojom::SchedulingPriority::kNormal;
       case gpu::SchedulingPriority::kLow:
