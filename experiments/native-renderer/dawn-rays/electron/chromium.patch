From eb17e188f32f7500c3ca457401e96168e7a4cf15 Mon Sep 17 00:00:00 2001
From: Ben Jude <19900120+fractaal@users.noreply.github.com>
Date: Fri, 6 Nov 2026 12:10:51 +0800
Subject: [PATCH 3/5] WebGPU devices parse WGSL on Dawn's worker pool
 (async_shader_module_parse)

The decoder asks for Dawn's async_shader_module_parse on the devices pages
create, unless --disable-dawn-features=async_shader_module_parse is given: the
GPU main thread, which every page's WebGPU and the compositor share, then
spends no time parsing one page's WGSL while another page waits. The decoder
processes Dawn's events while work is pending (PerformPollingWork), which the
toggle needs. about:gpu's list of WebGPU toggles says the same.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01ER71sVYGueZp5unvUUWTC4
---
 gpu/command_buffer/service/webgpu_decoder_impl.cc | 10 ++++++++++
 gpu/config/gpu_info_collector.cc                  |  6 ++++++
 2 files changed, 16 insertions(+)

diff --git a/gpu/command_buffer/service/webgpu_decoder_impl.cc b/gpu/command_buffer/service/webgpu_decoder_impl.cc
index a7d4f8792e..1d01a9b544 100644
--- a/gpu/command_buffer/service/webgpu_decoder_impl.cc
+++ b/gpu/command_buffer/service/webgpu_decoder_impl.cc
@@ -1557,6 +1557,16 @@ WGPUFuture WebGPUDecoderImpl::RequestDeviceImpl(
     require_device_disabled_toggles.push_back("timestamp_quantization");
   }
 
+  // Parse WGSL on Dawn's worker pool rather than on this thread, which every
+  // page's WebGPU and the compositor share: a page's shaders then hold up no
+  // other page's frames. This decoder processes Dawn's events while it waits
+  // (PerformPollingWork), as the toggle needs. Turned off with
+  // --disable-dawn-features=async_shader_module_parse.
+  if (!std::ranges::contains(require_disabled_toggles_,
+                             "async_shader_module_parse")) {
+    require_device_enabled_toggles.push_back("async_shader_module_parse");
+  }
+
   // We need the isolation key to create a device. We should already have it
   // because RequestAdapter waits to reply until we do.
   CHECK(isolation_key_.has_value());
diff --git a/gpu/config/gpu_info_collector.cc b/gpu/config/gpu_info_collector.cc
index 76f9aa04c8..9c140ea755 100644
--- a/gpu/config/gpu_info_collector.cc
+++ b/gpu/config/gpu_info_collector.cc
@@ -7,6 +7,7 @@
 #include <stddef.h>
 #include <stdint.h>
 
+#include <algorithm>
 #include <optional>
 #include <string>
 #include <utility>
@@ -267,6 +268,11 @@ void GetDawnTogglesForWebGPU(
   } else {
     force_disabled_toggles->push_back("timestamp_quantization");
   }
+  // Parse WGSL on Dawn's worker pool, as WebGPUDecoderImpl asks.
+  if (!std::ranges::contains(disabled_preference,
+                             "async_shader_module_parse")) {
+    force_enabled_toggles->push_back("async_shader_module_parse");
+  }
 
   for (const std::string& toggle : enabled_preference) {
     force_enabled_toggles->push_back(toggle.c_str());
