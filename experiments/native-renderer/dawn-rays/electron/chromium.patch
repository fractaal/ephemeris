+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "third_party/blink/renderer/modules/webgpu/gpu_acceleration_structure.h"
+
+#include "third_party/blink/renderer/bindings/modules/v8/v8_gpu_acceleration_structure_descriptor.h"
+#include "third_party/blink/renderer/bindings/modules/v8/v8_gpu_acceleration_structure_type.h"
+#include "third_party/blink/renderer/modules/webgpu/gpu_device.h"
+
+namespace blink {
+
+// static
+GPUAccelerationStructure* GPUAccelerationStructure::Create(
+    GPUDevice* device,
+    const GPUAccelerationStructureDescriptor* webgpu_desc) {
+  DCHECK(device);
+  DCHECK(webgpu_desc);
+
+  wgpu::AccelerationStructureDescriptor dawn_desc = {};
+  dawn_desc.type = webgpu_desc->type() ==
+                           V8GPUAccelerationStructureType::Enum::kBottomLevel
+                       ? wgpu::AccelerationStructureType::BottomLevel
+                       : wgpu::AccelerationStructureType::TopLevel;
+  dawn_desc.maxVertexCount = webgpu_desc->maxVertexCount();
+  dawn_desc.maxIndexCount = webgpu_desc->maxIndexCount();
+  dawn_desc.maxAABBCount = webgpu_desc->maxAABBCount();
+  dawn_desc.maxInstanceCount = webgpu_desc->maxInstanceCount();
+
+  std::string label = webgpu_desc->label().Utf8();
+  if (!label.empty()) {
+    dawn_desc.label = label.c_str();
+  }
+
+  return MakeGarbageCollected<GPUAccelerationStructure>(
+      device, device->GetHandle().CreateAccelerationStructure(&dawn_desc),
+      webgpu_desc->label());
+}
+
+GPUAccelerationStructure::GPUAccelerationStructure(
+    GPUDevice* device,
+    wgpu::AccelerationStructure structure,
+    const String& label)
+    : DawnObject<wgpu::AccelerationStructure>(device,
+                                              std::move(structure),
+                                              label) {}
+
+void GPUAccelerationStructure::destroy() {
+  GetHandle().Destroy();
+}
+
+}  // namespace blink
