 }
 
+GPUTexture* GPUDevice::importSharedTexture(VideoFrame* frame,
+                                           uint32_t usage,
+                                           ExceptionState& exception_state) {
+  scoped_refptr<media::VideoFrame> media_frame =
+      frame ? frame->frame() : nullptr;
+  if (!media_frame) {
+    exception_state.ThrowDOMException(DOMExceptionCode::kInvalidStateError,
+                                      "The VideoFrame is closed.");
+    return nullptr;
+  }
+  if (!media_frame->HasSharedImage()) {
+    exception_state.ThrowDOMException(
+        DOMExceptionCode::kNotSupportedError,
+        "The VideoFrame is not backed by a shared GPU texture.");
+    return nullptr;
+  }
+  wgpu::TextureUsage dawn_usage = static_cast<wgpu::TextureUsage>(usage);
+  scoped_refptr<WebGPUMailboxTexture> mailbox_texture =
+      WebGPUMailboxTexture::FromVideoFrame(GetDawnControlClient(), GetHandle(),
+                                           dawn_usage, media_frame);
+  if (!mailbox_texture) {
+    exception_state.ThrowDOMException(DOMExceptionCode::kOperationError,
+                                      "The shared texture could not be used.");
+    return nullptr;
+  }
+  wgpu::TextureFormat format = mailbox_texture->GetTexture().GetFormat();
+  return MakeGarbageCollected<GPUTexture>(
+      this, format, dawn_usage, std::move(mailbox_texture), String());
+}
+
 GPUBindGroup* GPUDevice::createBindGroup(
     const GPUBindGroupDescriptor* descriptor,
     ExceptionState& exception_state) {
