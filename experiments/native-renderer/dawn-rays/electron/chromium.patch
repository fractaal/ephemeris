 namespace gpu::webgpu {
 
+namespace {
+
+// The folder --gpu-shared-shader-cache names, empty if none. It holds one file
+// per entry, named by a hash of its key: an entry appears whole (written beside
+// it, then renamed), so that another browser can read it the moment it exists.
+const base::FilePath& SharedFolder() {
+  static const base::NoDestructor<base::FilePath> folder([] {
+    base::FilePath path =
+        base::CommandLine::ForCurrentProcess()->GetSwitchValuePath(
+            switches::kGpuSharedShaderCache);
+    if (!path.empty()) {
+      base::CreateDirectory(path);
+    }
+    return path;
+  }());
+  return *folder;
+}
+
+base::FilePath SharedEntry(std::string_view key) {
+  return SharedFolder().AppendASCII(
+      base::HexEncode(base::SHA1Hash(base::as_byte_span(key))));
+}
+
+}  // namespace
+
 DawnCachingInterface::DawnCachingInterface(scoped_refptr<MemoryCache> backend,
                                            CacheBlobCallback callback)
     : memory_cache_backend_(std::move(backend)),
@@ -55,6 +88,9 @@ void DawnCachingInterface::StoreData(std::span<const std::byte> key,
 }
 
 size_t DawnCachingInterface::FindKey(std::string_view key) {
+  if (!SharedFolder().empty()) {
+    return base::GetFileSize(SharedEntry(key)).value_or(0);
+  }
   if (memory_cache() == nullptr) {
     return 0u;
   }
@@ -67,6 +103,16 @@ size_t DawnCachingInterface::FindKey(std::string_view key) {
 
 size_t DawnCachingInterface::LoadData(std::string_view key,
                                       base::span<uint8_t> dst) {
+  if (!SharedFolder().empty()) {
+    base::File file(SharedEntry(key),
+                    base::File::FLAG_OPEN | base::File::FLAG_READ);
+    const int64_t size = file.IsValid() ? file.GetLength() : 0;
+    if (size <= 0 || static_cast<size_t>(size) > dst.size() ||
+        !file.ReadAndCheck(0, dst.first(static_cast<size_t>(size)))) {
+      return 0u;
+    }
+    return static_cast<size_t>(size);
+  }
   if (memory_cache() == nullptr) {
     return 0u;
   }
@@ -85,6 +131,15 @@ size_t DawnCachingInterface::LoadData(std::string_view key,
 
 void DawnCachingInterface::StoreData(std::string_view key,
                                      base::span<const uint8_t> src) {
+  if (!SharedFolder().empty()) {
+    base::FilePath temp;
+    if (!src.empty() && base::CreateTemporaryFileInDir(SharedFolder(), &temp) &&
+        (!base::WriteFile(temp, src) ||
+         !base::ReplaceFile(temp, SharedEntry(key), nullptr))) {
+      base::DeleteFile(temp);
+    }
+    return;
+  }
   if (memory_cache() == nullptr || src.empty()) {
     return;
   }
