 #include "ipc/ipc_mojo_bootstrap.h"
 #include "mojo/public/cpp/bindings/sync_call_restrictions.h"
@@ -227,6 +228,13 @@ ContextResult CommandBufferProxyImpl::Initialize(
   // prevent cleanup on destruction.
   auto channel = std::move(channel_);
 
+  // (a renderer the browser put behind the rest: every context of it, whatever
+  // it asked for; switches::kGpuStreamPriorityLow)
+  if (base::CommandLine::ForCurrentProcess()->HasSwitch(
+          switches::kGpuStreamPriorityLow)) {
