 const gpu::SchedulingPriority kGpuStreamPriorityMedia =
     gpu::SchedulingPriority::kHigh;
 
-// Used for renderer raster worker context.
+// Used for renderer raster worker context. (kNormal: what kLow reached the GPU
+// process as before kLow went through as itself; switches::kGpuLowPrioritySite.)
 const gpu::SchedulingPriority kGpuStreamPriorityWorker =
-    gpu::SchedulingPriority::kLow;
+    gpu::SchedulingPriority::kNormal;
 
 }  // namespace content
 
diff --git a/gpu/config/gpu_switches.cc b/gpu/config/gpu_switches.cc
index 3af3b71ef1..5dc3a91e32 100644
--- a/gpu/config/gpu_switches.cc
+++ b/gpu/config/gpu_switches.cc
@@ -177,4 +177,14 @@ const char kSuppressPerformanceLogs[] = "suppress-performance-logs";
 // it runs as well as after it has gone.
 const char kGpuSharedShaderCache[] = "gpu-shared-shader-cache";
 
+// Sites (comma-separated, such as http://localhost) whose renderers' GPU work
+// waits behind every other page's and the browser's own: each renderer process
+// locked to one is launched with --gpu-stream-priority-low. A page drawing heavy
+// frames there leaves the window its turn on the GPU process's main thread.
+const char kGpuLowPrioritySite[] = "gpu-low-priority-site";
+
+// Given to a renderer by the browser (kGpuLowPrioritySite): all its GPU contexts
+// (WebGPU, WebGL, canvases, its compositor) at SchedulingPriority::kLow.
+const char kGpuStreamPriorityLow[] = "gpu-stream-priority-low";
+
 }  // namespace switches
diff --git a/gpu/config/gpu_switches.h b/gpu/config/gpu_switches.h
index 73a87870a1..abd31c252a 100644
--- a/gpu/config/gpu_switches.h
